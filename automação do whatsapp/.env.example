NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/petshop_whatsapp
REDIS_URL=redis://localhost:6379

# WhatsApp Business Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=troque-este-token
WA_APP_SECRET=

# URLs publicas (ngrok / cloudflare tunnel)
APP_BASE_URL=https://seu-dominio.com
PANEL_WEBHOOK_URL=${APP_BASE_URL}/webhooks/whatsapp

# Chatbot
CHATBOT_ENABLED=true
CHATBOT_WELCOME_FLOW=petshop_welcome
