{
  "name": "petflow",
  "version": "0.1.0",
  "private": true,
  "description": "PetFlow - SaaS de gestão para pet shops",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @petflow/api",
    "dev:web": "npm run dev --workspace @petflow/web",
    "dev:worker": "npm run dev --workspace @petflow/worker",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:validate": "prisma validate --schema database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
