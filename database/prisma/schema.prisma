generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  MEMBER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ProductUnit {
  UNIDADE
  KG
  G
  L
  ML
  CAIXA
  PACOTE
  ROLLO
}

enum StockMovementType {
  IN
  OUT
  ADJUST_POSITIVE
  ADJUST_NEGATIVE
}

enum PaymentMethod {
  CASH
  CARD
  PIX
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

enum CashMovementOrigin {
  MANUAL
  SALE
  SALE_CANCELMENT
  REVERSAL
}

model Company {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  users     User[]
  categories Category[]
  suppliers  Supplier[]
  products   Product[]
  stockMovements StockMovement[]
  sales      Sale[]
  cashSessions   CashSession[]
  cashMovements  CashMovement[]
}

model User {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  stockMovements StockMovement[]
  salesCreated   Sale[] @relation("SaleCreatedBy")
  salesCancelled Sale[] @relation("SaleCancelledBy")
  cashSessionsOpened CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashSessionClosedBy")
  cashMovements  CashMovement[]
  movementsReversed   CashMovement[] @relation("MovementReversedBy")

  @@unique([companyId, email])
  @@index([companyId, status])
}

model Session {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name        String
  nameKey     String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]

  @@unique([companyId, nameKey])
  @@index([companyId, status])
}

model Supplier {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name      String
  document  String?
  email     String?
  phone     String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  Product[]

  @@index([companyId, status])
  @@index([companyId, name])
}

model Product {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  sku           String?
  barcode       String?
  unit          ProductUnit   @default(UNIDADE)
  costPrice     Decimal       @default(0) @db.Decimal(12, 2)
  salePrice     Decimal       @default(0) @db.Decimal(12, 2)
  stockQuantity Decimal       @default(0) @db.Decimal(12, 3)
  minimumStock  Decimal       @default(0) @db.Decimal(12, 3)
  status        RecordStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  movements     StockMovement[]
  saleItems     SaleItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, status])
  @@index([companyId, name])
}

model StockMovement {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  notes           String?
  reference       String?
  createdByUserId String
  createdBy       User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@index([companyId, productId, createdAt])
  @@index([companyId, createdAt])
}

model Sale {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receiptCode       String
  clientRequestId   String?
  status            SaleStatus       @default(COMPLETED)
  subtotal          Decimal          @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentNote       String?
  createdByUserId   String
  createdBy         User             @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?            @relation("SaleCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelReason      String?
  cashSessionId     String?
  cashSession       CashSession?     @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  items             SaleItem[]
  cashMovements     CashMovement[]

  @@unique([companyId, receiptCode])
  @@unique([companyId, clientRequestId])
  @@index([companyId, createdAt])
  @@index([companyId, status])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  productSku  String?
  unit        ProductUnit
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Decimal  @db.Decimal(12, 3)
  subtotal    Decimal  @db.Decimal(12, 2)

  @@index([saleId])
}

model CashSession {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status          CashSessionStatus @default(OPEN)
  initialAmount   Decimal           @db.Decimal(12, 2)
  openingNotes    String?
  openedByUserId  String
  openedBy        User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  closedByUserId  String?
  closedBy        User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closingNotes    String?
  countedAmount   Decimal?          @db.Decimal(12, 2)
  expectedAmount  Decimal?          @db.Decimal(12, 2)
  difference      Decimal?          @db.Decimal(12, 2)
  movements       CashMovement[]
  sales           Sale[]

  @@index([companyId, status])
  @@index([companyId, openedAt])
}

model CashMovement {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashSessionId    String
  cashSession      CashSession        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  type             CashMovementType
  origin           CashMovementOrigin
  inCash           Boolean            @default(true)
  amount           Decimal            @db.Decimal(12, 2)
  description      String
  justification    String?
  saleId           String?
  sale             Sale?              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reversalOfId     String?
  reversalOf       CashMovement?      @relation("MovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals        CashMovement[]     @relation("MovementReversal")
  reversedAt       DateTime?
  reversedByUserId String?
  reversedBy       User?              @relation("MovementReversedBy", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  reversalReason   String?
  createdByUserId  String
  createdBy        User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())

  @@unique([origin, saleId])
  @@index([companyId, createdAt])
  @@index([companyId, cashSessionId])
  @@index([companyId, saleId])
}
